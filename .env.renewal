# Runtime profile
GAME_MODE=renewal
PACKETVER=20250122
RENEWAL=true

#questa e la variabile per renewal dei config.local.js lasciare true false ti fa caricare grf da web
USE_LOCAL_CONFIG=true


# Database
GAME_DB_NAME=ragnarok
MYSQL_HOST=db
DB_PORT=3306
MYSQL_USER=ragnarok
MYSQL_PASSWORD=ragnarok
MYSQL_ROOT_PASSWORD=ragnarok


# Game network
# IP LAN o dominio pubblico raggiungibile dal client.
GAME_HOST=192.168.179.5
RATHENA_BIND_IP=0.0.0.0
LOGIN_PORT=6900
CHAR_PORT=6121
MAP_PORT=5121

# Client
# Il tipo renewal/pre-renewal e le packet keys vengono derivati dal PACKETVER.
LANGTYPE=1
CLIENT_VERSION=55
WORLD_MAP_EPISODE=12
CLIENT_GRF_LIST=DATA.INI

# Public services
WEB_PORT=8080
FLUXCP_PORT=8081
WSPROXY_PORT=5999
PHPMYADMIN_PORT=9000

# FluxCP
FLUX_INSTALLER_PASSWORD=ragnarok
FLUX_SERVER_ADDRESS=192.168.179.5:8081
FLUX_BASE_URI=
FLUX_FORCE_HTTPS=0
FLUX_REQUIRE_OWNERSHIP=0

FLUX_INSTALLER_PASSWORD=installer
# docker compose --env-file .env.renewal up -d --build
