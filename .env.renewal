# Runtime profile
GAME_MODE=renewal
PACKETVER=20250122
RENEWAL=true

#questa e la variabile per renewal dei config.local.js lasciare true false ti fa caricare grf da web
USE_LOCAL_CONFIG=true


# Database
GAME_DB_NAME=ragnarok
MYSQL_HOST=db
DB_PORT=3306
MYSQL_USER=ragnarok
MYSQL_PASSWORD=ragnarok
MYSQL_ROOT_PASSWORD=ragnarok


# rAthena network
# Inserire qui il proprio IP LAN o dominio pubblico (verra' letto automaticamente anche da roBrowser index.html):
RATHENA_HOST=192.168.179.5
RATHENA_BIND_IP=0.0.0.0
LOGIN_PORT=6900
CHAR_PORT=6121
MAP_PORT=5121

# Public services
WEB_PORT=8080
FLUXCP_PORT=8081
WSPROXY_PORT=5999
PHPMYADMIN_PORT=9000

# FluxCP
FLUX_INSTALLER_PASSWORD=ragnarok
FLUX_SERVER_ADDRESS=192.168.179.5:8081
FLUX_BASE_URI=
FLUX_FORCE_HTTPS=0
FLUX_REQUIRE_OWNERSHIP=0

FLUX_INSTALLER_PASSWORD=installer
